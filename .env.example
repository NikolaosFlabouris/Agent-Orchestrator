# Agent Orchestrator - Environment Configuration
# Copy this file to .env and fill in the values.
# The .env file must NOT be committed to version control.

# =============================================================================
# Forgejo Connection
# =============================================================================

# URL of the Forgejo instance (no trailing slash)
FORGEJO_URL=http://forgejo-host:3000

# API token for the 'orchestrator' Forgejo account
# Scopes required: read: user, write:repository, write:issue
# Used for: PR creation, merge, label management, issue comments
FORGEJO_ORCHESTRATOR_TOKEN=

# API token for the 'agent' Forgejo account
# Scopes required: write:repository
# Used for: git fetch/push in agent container workspaces
FORGEJO_AGENT_TOKEN=

# Secret for verifying Forgejo webhook signatures (HMAC-SHA256)
# Set this to a random string and use the same value when registering webhooks
FORGEJO_WEBHOOK_SECRET=

# =============================================================================
# Forgejo OAuth2 (UI Authentication)
# =============================================================================

# OAuth2 application credentials registered in Forgejo.
# Create at: Forgejo > Site Administration > Applications
# Redirect URI: http://<orchestrator-host>:8080/auth/callback
#
# REQUIRED. The orchestrator refuses to start without these unless
# ORCHESTRATOR_ALLOW_UNAUTHENTICATED=1 is set (dev-only escape hatch;
# forces a 127.0.0.1 bind). In production NODE_ENV=production the escape
# hatch is ignored and the boot fails hard.
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# =============================================================================
# Orchestrator
# =============================================================================

# Public URL of this orchestrator (used for OAuth callback and webhook URLs)
ORCHESTRATOR_URL=http://localhost:8080

# =============================================================================
# LLM API Keys
# =============================================================================

# Anthropic API key for Claude Agent SDK and Claude Code CLI
# Required if using claude-agent-sdk or claude-code-cli agent tools
ANTHROPIC_API_KEY=

# Optional: API key for OpenCode when using a remote provider that requires auth
# Not needed for local LLM servers without authentication
# OPENCODE_API_KEY=

# =============================================================================
# Orchestrator runtime (optional)
# =============================================================================

# Cookie signing secret for session cookies. REQUIRED — must be at least
# 32 characters. The signed cookie is the entire auth surface, so a weak
# or missing value lets any LAN attacker mint valid sessions. The
# orchestrator refuses to start with a missing/short secret unless
# ORCHESTRATOR_ALLOW_DEFAULT_COOKIE_SECRET=1 is set (dev-only escape
# hatch; forces a 127.0.0.1 bind). In production NODE_ENV=production the
# escape hatch is ignored and the boot fails hard.
# Generate with: openssl rand -hex 32
COOKIE_SECRET=

# Pino log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# =============================================================================
# Dev / degraded-security escape hatches (DO NOT SET IN PRODUCTION)
# =============================================================================

# Set to "1" to allow boot without FORGEJO_OAUTH_CLIENT_ID/SECRET. The
# orchestrator then runs with /api/* unauthenticated and forces a
# 127.0.0.1 bind inside the container. Ignored when NODE_ENV=production.
# ORCHESTRATOR_ALLOW_UNAUTHENTICATED=

# Set to "1" to allow boot with a missing/short COOKIE_SECRET (dev
# placeholder is used; 127.0.0.1 bind is forced). Ignored when
# NODE_ENV=production.
# ORCHESTRATOR_ALLOW_DEFAULT_COOKIE_SECRET=

# Override the inside-container bind host. Default behaviour: 0.0.0.0
# when auth + cookie are fully configured, 127.0.0.1 otherwise. Set
# this explicitly to 0.0.0.0 only when you genuinely want an
# OAuth-authenticated instance reachable from the LAN, and also flip
# docker-compose.yml's port mapping from 127.0.0.1:8081:8080 to
# 0.0.0.0:8081:8080. Both layers must opt in.
# ORCHESTRATOR_BIND_HOST=

# NODE_ENV controls the strictness of the security checks above.
# Set to "production" on real deployments — both dev-flag escape
# hatches are ignored when this is "production".
# NODE_ENV=development
