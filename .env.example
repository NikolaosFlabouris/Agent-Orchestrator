# Agent Orchestrator - Environment Configuration
# Copy this file to .env and fill in the values.
# The .env file must NOT be committed to version control.

# =============================================================================
# Forgejo Connection
# =============================================================================

# URL of the Forgejo instance (no trailing slash)
FORGEJO_URL=http://forgejo-host:3000

# API token for the 'orchestrator' Forgejo account
# Scopes required: read: user, write:repository, write:issue
# Used for: PR creation, merge, label management, issue comments
FORGEJO_ORCHESTRATOR_TOKEN=

# API token for the 'agent' Forgejo account
# Scopes required: write:repository
# Used for: git fetch/push in agent container workspaces
FORGEJO_AGENT_TOKEN=

# Secret for verifying Forgejo webhook signatures (HMAC-SHA256)
# Set this to a random string and use the same value when registering webhooks
FORGEJO_WEBHOOK_SECRET=

# =============================================================================
# Forgejo OAuth2 (UI Authentication)
# =============================================================================

# OAuth2 application credentials registered in Forgejo
# Create at: Forgejo > Site Administration > Applications
# Redirect URI: http://<orchestrator-host>:8080/auth/callback
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# =============================================================================
# Orchestrator
# =============================================================================

# Public URL of this orchestrator (used for OAuth callback and webhook URLs)
ORCHESTRATOR_URL=http://localhost:8080

# =============================================================================
# LLM API Keys
# =============================================================================

# Anthropic API key for Claude Agent SDK and Claude Code CLI
# Required if using claude-agent-sdk or claude-code-cli agent tools
ANTHROPIC_API_KEY=

# Optional: API key for OpenCode when using a remote provider that requires auth
# Not needed for local LLM servers without authentication
# OPENCODE_API_KEY=

# =============================================================================
# Orchestrator runtime (optional — sensible defaults are used if unset)
# =============================================================================

# HTTP bind — defaults: 0.0.0.0:8080 inside the container; host-exposed on 8081
# via docker-compose. Change PORT only if you remap the compose port.
# HOST=0.0.0.0
# PORT=8080

# Cookie signing secret for session cookies. MUST be set to a random value in
# production. If unset, a dev-only default is used and a warning is logged.
# Generate with: openssl rand -hex 32
# COOKIE_SECRET=

# Pino log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# SQLite data directory (must be writable). In the shipped docker-compose.yml
# this is a named volume mounted at /data. Override only if running outside
# compose.
# DATA_DIR=/data
# DB_PATH=/data/orchestrator.db

# Workspace + cache roots (bind mounts from docker-compose by default).
# Override only if running the orchestrator outside a container.
# WORKSPACES_ROOT=/workspaces
# CACHES_ROOT=/caches

# Root path of the repository inside the orchestrator container. Used by the
# image-rebuild endpoint to find the images/ directory. Defaults to /app
# (matches the orchestrator Dockerfile WORKDIR).
# PROJECT_ROOT=/app
