# =============================================================================
# Agent Orchestrator — Environment Configuration
# =============================================================================
#
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# After any change, `docker compose up -d` to restart the orchestrator.
#
# Quick checklist for a fresh install:
#   1. NODE_ENV                            (set to "production" for real deployments)
#   2. ORCHESTRATOR_URL                    (browser-reachable URL of the orchestrator)
#   3. COOKIE_SECRET                       (openssl rand -hex 32)
#   4. FORGEJO_URL                         (must be reachable from inside containers)
#   5. FORGEJO_ORCHESTRATOR_TOKEN          (Forgejo API token, scopes below)
#   6. FORGEJO_AGENT_TOKEN                 (Forgejo API token, narrower scope)
#   7. FORGEJO_WEBHOOK_SECRET              (openssl rand -hex 16)
#   8. FORGEJO_OAUTH_CLIENT_ID + SECRET    (Forgejo OAuth2 app)
#   9. ANTHROPIC_API_KEY                   (or CLAUDE_CODE_OAUTH_TOKEN for the
#                                           subscription profile — at least one
#                                           is required for the seeded defaults)
#  10. MCP_ENABLED + MCP_OAUTH_SIGNING_SECRET (optional — only when exposing the
#                                          orchestrator's MCP endpoint; see the
#                                          "MCP" section below)
#
# Everything below #9 is optional; defaults work out of the box.


# =============================================================================
# Core orchestrator
# =============================================================================

# Deployment mode. Controls how strictly the boot path enforces security.
#   "production"  → refuses to start without OAuth + a strong COOKIE_SECRET.
#                   The dev escape hatches at the bottom of this file are
#                   IGNORED regardless of how they're set.
#   anything else → escape hatches are honoured if you opt into them, but
#                   the orchestrator still refuses to start with neither
#                   real OAuth NOR ORCHESTRATOR_ALLOW_UNAUTHENTICATED=1.
NODE_ENV=production

# Public URL the orchestrator advertises (used for the OAuth callback URL
# and the webhook target it registers with Forgejo). This is the URL a
# BROWSER would type into the address bar to reach the orchestrator's UI.
#
# Default docker-compose.yml maps host port 8081 → container port 8080, so:
#   * Local-only install:     http://localhost:8081
#   * LAN-reachable install:  http://<host-lan-ip>:8081
# If you change the host-side port in docker-compose.yml, change it here too.
# Whatever you set must match the Redirect URI registered on the Forgejo
# OAuth application exactly (plus `/auth/callback`).
ORCHESTRATOR_URL=http://localhost:8081

# Cookie signing secret. REQUIRED — minimum 32 characters. The signed
# session cookie IS the auth surface, so a missing/short value would let
# anyone reachable on the listening interface mint sessions. The boot path
# refuses to start without this unless ORCHESTRATOR_ALLOW_DEFAULT_COOKIE_SECRET=1
# (ignored when NODE_ENV=production).
# Generate with: openssl rand -hex 32
COOKIE_SECRET=


# =============================================================================
# Forgejo connection
# =============================================================================

# Base URL of the Forgejo instance, no trailing slash.
#
# Important: this URL must be reachable from INSIDE the orchestrator
# container (and from inside agent containers, which talk to Forgejo too).
# `localhost` resolves to the container itself and won't work. Common values:
#   * Forgejo on same host as orchestrator:   http://<host-lan-ip>:3000
#   * Forgejo on Docker Desktop (Mac/Windows): http://host.docker.internal:3000
#   * Forgejo on the same docker network:      http://forgejo:3000  (service name)
FORGEJO_URL=http://forgejo-host:3000

# API token for the `orchestrator` Forgejo service account.
# Scopes required: read:user, write:repository, write:issue
# Used for: PR creation, merge, label management, issue comments.
# Generate at: <FORGEJO_URL>/-/user/settings/applications (logged in as `orchestrator`)
FORGEJO_ORCHESTRATOR_TOKEN=

# API token for the `agent` Forgejo service account.
# Scopes required: write:repository
# Used ONLY for git fetch/push inside disposable agent containers — the
# blast radius if leaked is limited to git operations. Keep this account
# separate from the orchestrator account on purpose.
FORGEJO_AGENT_TOKEN=

# Shared HMAC secret used by Forgejo to sign webhook payloads. The
# orchestrator verifies the signature on `/webhooks/forgejo`.
# Set this to any random string and re-use the same value when registering
# webhooks in Forgejo (per repository).
# Generate with: openssl rand -hex 16
FORGEJO_WEBHOOK_SECRET=


# =============================================================================
# Forgejo OAuth2 (UI authentication)
# =============================================================================

# OAuth2 application credentials registered in Forgejo.
# Create at: Forgejo > Site Administration > Applications > OAuth2 Applications.
# Redirect URI on the application must be `${ORCHESTRATOR_URL}/auth/callback`
# exactly, e.g. http://localhost:8081/auth/callback for the default mapping.
#
# REQUIRED unless ORCHESTRATOR_ALLOW_UNAUTHENTICATED=1 (dev-only escape
# hatch; ignored when NODE_ENV=production).
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=


# =============================================================================
# MCP (Model Context Protocol) endpoint
# =============================================================================
#
# The orchestrator can expose its task surface as a Model Context Protocol
# server at /mcp, consumable by MCP clients (Claude Code's create-task-forgejo
# plugin, etc.). The endpoint is OAuth-protected (the orchestrator acts as
# both the MCP Resource Server and an embedded OAuth 2.1 Authorization
# Server — discovery + DCR + authorize + token endpoints live under
# /mcp/oauth/* and /.well-known/oauth-*).

# Set to "1" to enable the /mcp transport endpoint. Anything else
# (unset, empty, "0") keeps it disabled — /mcp returns 503 with an
# `mcp_disabled` body. The /mcp/oauth/* endpoints and the discovery
# documents remain reachable regardless so a client probing the well-
# known URLs gets a coherent answer.
# MCP_ENABLED=

# Signing key for the HS256 access JWTs the orchestrator issues to MCP
# clients. Two acceptable arrangements:
#   * Set explicitly (≥32 chars) — operator wants to rotate the MCP
#     signing key independently of the UI cookie secret. Generate with:
#       openssl rand -hex 32
#   * Leave blank — the orchestrator derives a key from COOKIE_SECRET
#     via HKDF-SHA256 with a distinct info label ("mcp-oauth-jwt-hs256"),
#     which is cryptographically equivalent and avoids forcing operators
#     to manage a second secret. COOKIE_SECRET must already be ≥32 chars
#     in production (the boot path enforces it).
# Rotation: bump the value AND restart the orchestrator. All currently-
# issued MCP access + refresh tokens become invalid; clients re-auth via
# /mcp the next time they connect.
# MCP_OAUTH_SIGNING_SECRET=


# =============================================================================
# Provider credentials forwarded to agent containers
# =============================================================================
#
# Each entry below corresponds to a `provider` row seeded on first run
# (Settings → Providers & Models). The provider row points at the env-var
# name; the orchestrator reads the value from this file and exports it
# into the agent container under the LLM SDK's standard env-var name when
# launching a task against that provider.
#
# You only need keys for providers you actually use. Empty entries are
# fine — the provider just shows "missing credential" in the Settings UI
# until you fill the value in.

# Anthropic Console API key (pay-per-token). Used by:
#   * Provider `anthropic` (kind: anthropic) — for the seeded
#     `default-claude-sdk` profile (Claude SDK + Sonnet).
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Anthropic Pro/Max subscription OAuth token. Used by:
#   * Provider `claude-subscription` (kind: claude-subscription) — for the
#     seeded `default-claude-code-subscription` profile (Claude Code CLI).
# Drives the Claude Code CLI against your subscription quota instead of
# pay-per-token API access. To obtain a long-lived token, run
# `claude setup-token` against an interactive Claude Code install on a
# trusted machine. Leave blank if you only use API-key access.
# CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI API key. Used by Provider `openai` (kind: openai).
# Get one at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Google AI Studio API key. Used by Provider `gemini` (kind: gemini).
# Get one at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Mistral API key. Used by Provider `mistral` (kind: mistral).
# Get one at: https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=

# DeepSeek API key. Used by Provider `deepseek` (kind: deepseek).
# Get one at: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=

# OpenRouter API key. Used by Provider `openrouter` (kind: openrouter).
# OpenRouter is a meta-provider that proxies to many upstream LLMs under
# one key — useful for trying models without separate accounts.
# Get one at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Ollama uses no env var by default (it's self-hosted; auth-optional). If
# you put basic-auth in front of your Ollama server, the orchestrator
# reads the bearer token from each Ollama provider row's `auth_token`
# (set inline via the Settings UI). No global env var to set here.

# Custom env-var names: if you author a provider row in the Settings UI
# with `api_key_env_var = MY_CUSTOM_KEY`, add `MY_CUSTOM_KEY=...` here.
# The orchestrator reads any env-var name the provider row references.


# =============================================================================
# Orchestrator runtime (optional)
# =============================================================================

# Pino log level for the orchestrator process.
# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Override the SQLite path. Useful when running `npm run dev` outside
# Docker and you don't have a `/data` volume mounted. Inside the Docker
# image, the default points at the `/data` named volume; you don't need
# to change this for the standard docker-compose bring-up.
# DB_PATH=/data/orchestrator.db


# =============================================================================
# Dev / degraded-security escape hatches
# =============================================================================
# These are intentional foot-guns for local development. They lower the
# security posture; the orchestrator forces a 127.0.0.1 inside-container
# bind whenever either is set, so a degraded instance is unreachable from
# the LAN even by accident. ALL three are IGNORED when NODE_ENV=production.

# Set to "1" to allow boot without FORGEJO_OAUTH_CLIENT_ID/SECRET. The
# orchestrator runs with /api/* unauthenticated. Loud `auth_disabled`
# warning is logged at startup so you don't forget it's on.
# ORCHESTRATOR_ALLOW_UNAUTHENTICATED=

# Set to "1" to allow boot with a missing/short COOKIE_SECRET. A
# hardcoded dev placeholder is used in place of the real value.
# ORCHESTRATOR_ALLOW_DEFAULT_COOKIE_SECRET=

# Override the inside-container bind host. Default behaviour:
#   * 0.0.0.0   when auth + cookie are fully configured (the normal case)
#   * 127.0.0.1 when in degraded-security mode (auth-disabled or dev-cookie)
# Set this to 0.0.0.0 explicitly ONLY when you want an OAuth-authenticated
# instance reachable from the LAN AND you've flipped docker-compose.yml's
# port mapping to `0.0.0.0:8081:8080`. Both layers must opt in — either
# one alone keeps you on loopback.
# ORCHESTRATOR_BIND_HOST=
